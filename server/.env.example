# Copy to server/.env for local development. Real secrets are never committed
# (CONSTRAINTS #27); .env is gitignored, only this template is tracked.

# Django
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches docker-compose service defaults)
DATABASE_URL=postgres://assen:assen@localhost:5432/assen

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional: short commit hash surfaced by /api/health and /readyz when .git is
# absent. GIT_SHA takes precedence over COMMIT_SHA if both are set.
COMMIT_SHA=
# GIT_SHA=

# --- 실제 이메일 발송 (config.email) ------------------------------------------
# dev/test/demo 는 mock 발송기(로그만) 이므로 아래 값이 필요 없다. base/prod 는 mock 이
# 절대 켜지지 않으므로, 이메일 가입/로그인을 쓰려면 아래를 채워야 한다.
# FAIL-CLOSED: 미설정이거나 일부만 채우면 발송기가 선택되지 않고 이메일 가입이 503.
# EMAIL_SENDER_BACKEND=ses          # ses | smtp | (미설정=없음). 그 외 값은 prod 부팅 실패
# EMAIL_FROM_ADDRESS=no-reply@assen.example   # 인증 메일 From (ses 는 검증된 identity 여야 함)
# WEB_BASE_URL=https://assen.example          # 인증 링크 = {WEB_BASE_URL}/verify-email?token=…
#
# ses 백엔드: 자격증명은 env 로 받지 않는다 — boto3 가 ECS 태스크 롤에서 해결한다.
# EMAIL_SES_REGION=ap-northeast-2
#
# smtp 백엔드: EMAIL_HOST 가 활성화 키(비어 있으면 미구성). 사용자/비밀번호는 선택.
# EMAIL_HOST=smtp.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10

# Observability (R4-W2). All optional and fail-safe.
# DJANGO_LOG_LEVEL=INFO                      # root/app log level (dev+prod)
# SENTRY_DSN=                                # unset → Sentry is a no-op (dev/test/local)
# SENTRY_TRACES_SAMPLE_RATE=0.0              # performance tracing sample rate
# DJANGO_ENV=production                      # Sentry environment tag

# --- Production (config.settings.prod) — SDLC 11 §2/§4 ---------------------
# prod 모듈은 fail-closed: 아래 두 값이 없으면 부팅 자체가 실패한다.
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_SECRET_KEY=                        # 필수 (Secrets Manager 주입)
# DJANGO_ALLOWED_HOSTS=api.assen.example    # 필수
# DJANGO_CSRF_TRUSTED_ORIGINS=https://assen.example
# CORS_ALLOWED_ORIGINS=https://assen.example  # 교차 오리진(옵션 A)일 때만 — 웹 NEXT_PUBLIC_API_URL과 짝. 동일 오리진(옵션 B)은 비워 둔다(차단 기본)
# DJANGO_SECURE_SSL_REDIRECT=true           # /healthz 는 리다이렉트 면제(ALB 프로브)

# --- 업로드 / 미디어 (apps.uploads) ----------------------------------------
# 업로드 표면의 스위치는 이 하나뿐이다. 기본 False(fail-closed) — 켜지 않으면 모든
# 업로드가 503. 켜는 것만으로는 부족하다: 스토리지 백엔드가 실제로 객체를 담을 수
# 있어야 한다(config.storage.media_storage_ready). 로컬 파일시스템은 항상 담을 수
# 있으므로, 실질적으로 걸리는 경우는 "S3 백엔드인데 버킷 이름이 비어 있음" 하나다.
# prod 조합 = ALLOW_UPLOADS=true + DJANGO_MEDIA_S3_BUCKET 지정.
# ALLOW_UPLOADS=true
#
# 미디어 읽기는 백엔드와 무관하게 **항상 Django 가 서빙**한다(apps.uploads.media).
# 버킷 직결 서명 URL 을 쓰지 않는 이유: (1) 서명 URL 은 ~1시간 뒤 만료되는데 그 URL 이
# Upload 행과 Post/Product.media_url 에 그대로 저장되므로 업로드 1시간 뒤 모든 이미지가
# 깨진다, (2) 버킷 직결 읽기는 Django 를 거치지 않아 신고-기반 테이크다운이 무력해진다.
# (과거의 SERVE_LOCAL_MEDIA 플래그는 이 결정으로 폐지됐다 — 항상 Django 가 서빙한다.)
#
# 실제 객체 스토리지(S3). 값이 있으면 default_storage 가 이 PRIVATE 버킷을 사용한다.
# 버킷은 퍼블릭 액세스 차단 필수 — 유일한 독자는 앱 티어(ECS 태스크 롤)다.
# DJANGO_MEDIA_S3_BUCKET=assen-media-prod
# DJANGO_MEDIA_S3_REGION=ap-northeast-2
#
# DJANGO_MEDIA_URL=/media/                  # 기본값. 사이트 상대 경로를 유지해야 한다
#                                           # (Upload.url 이 이 값 + 키로 만들어지고,
#                                           #  /media/ 라우트가 그것을 되받는다)
# DJANGO_MEDIA_ROOT=                        # 로컬 볼륨 경로(dev/demo)
# UPLOAD_MAX_BYTES=10485760                 # 단일 파일 상한(기본 10 MiB)
# UPLOAD_MAX_PIXELS=40000000                # 디코드 후 픽셀 수 상한(압축폭탄 방어)
# UPLOAD_MAX_DIMENSION=12000                # 한 변 최대 픽셀
