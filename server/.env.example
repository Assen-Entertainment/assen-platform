# Copy to server/.env for local development. Real secrets are never committed
# (CONSTRAINTS #27); .env is gitignored, only this template is tracked.

# Django
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches docker-compose service defaults)
DATABASE_URL=postgres://assen:assen@localhost:5432/assen

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional: short commit hash surfaced by /api/health when .git is absent.
COMMIT_SHA=

# --- Production (config.settings.prod) — SDLC 11 §2/§4 ---------------------
# prod 모듈은 fail-closed: 아래 두 값이 없으면 부팅 자체가 실패한다.
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_SECRET_KEY=                        # 필수 (Secrets Manager 주입)
# DJANGO_ALLOWED_HOSTS=api.assen.example    # 필수
# DJANGO_CSRF_TRUSTED_ORIGINS=https://assen.example
# CORS_ALLOWED_ORIGINS=https://assen.example  # 교차 오리진(옵션 A)일 때만 — 웹 NEXT_PUBLIC_API_URL과 짝. 동일 오리진(옵션 B)은 비워 둔다(차단 기본)
# DJANGO_SECURE_SSL_REDIRECT=true           # /healthz 는 리다이렉트 면제(ALB 프로브)
