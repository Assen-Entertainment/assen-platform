# Assen 웹 환경변수 (복사 → .env.local)
# ⚠️ NEXT_PUBLIC_* 는 빌드 타임에 번들로 인라인된다 — 컨테이너는 build-arg로 주입(web/Dockerfile).

# 사이트 절대 URL (metadataBase·sitemap)
NEXT_PUBLIC_SITE_URL=https://assen.example

# 백엔드 B-API 베이스. 미설정 시 lib/api가 in-file mock으로 폴백(백엔드 없이 빌드/개발 가능).
#  - dev 프록시 모드(권장):  /api   (아래 API_PROXY_TARGET 프록시로 동일 오리진화 → 쿠키 Lax 송신)
#  - 크로스 오리진 직접 호출:  https://api.assen.example/api
#    (브라우저에서 직접 호출되므로 웹 오리진이 서버 CORS_ALLOWED_ORIGINS에 등록돼야 한다 — SDLC 11 §4)
NEXT_PUBLIC_API_URL=

# SSR(서버 컴포넌트) 전용 백엔드 절대 URL. 프록시 모드에서 NEXT_PUBLIC_API_URL=/api(상대)면
# 서버 fetch가 절대 URL을 필요로 하므로 여기서 지정한다. 미설정 시 NEXT_PUBLIC_API_URL로 폴백.
#  - 로컬 백엔드 예:  http://127.0.0.1:8000/api
API_INTERNAL_URL=

# dev rewrites 프록시 대상(next.config.mjs). 미설정 시 http://127.0.0.1:8000.
API_PROXY_TARGET=http://127.0.0.1:8000

# 실시간 알림 WebSocket 오리진(R4-W4, Channels ws/notifications). 미설정 시 실시간 소켓 완전 비활성.
#  ⚠️ WS는 Next rewrites로 프록시되지 않으므로 API와 별도 오리진(절대 URL)이 필요하다.
#  - 로컬 예:  ws://127.0.0.1:8000/ws/notifications
#  - 운영 예:  wss://api.assen.example/ws/notifications
#  (인증은 httpOnly assen_access 쿠키 — 동일 도메인이면 브라우저가 credentialed WS로 자동 송신)
NEXT_PUBLIC_WS_URL=

# Sentry 에러 트래킹(ASS-270) — env-gated: DSN 미설정 시 init 자체가 스킵된다(서버
# config/observability.py의 init_sentry()와 동일한 no-op-without-DSN 계약, dev/test 무영향).
#  - 서버/엣지(instrumentation.ts)용 DSN. 미설정 시 서버측 Sentry 완전 비활성.
SENTRY_DSN=
#  - 브라우저(instrumentation-client.ts)용 DSN. NEXT_PUBLIC_* 이므로 빌드타임에 번들 인라인.
#    미설정 시 클라이언트측 Sentry 완전 비활성.
NEXT_PUBLIC_SENTRY_DSN=
# 환경 태그(선택, 미설정 시 NODE_ENV로 폴백) — 예: production/staging/preview.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# 트레이스 샘플링 비율(0~1, 선택, 기본 0.1 — 보수적).
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# 소스맵 업로드용 Sentry 인증 토큰(선택). 미설정 시 소스맵 생성/업로드를 건너뛰며 빌드는
# 실패하지 않는다(next.config.mjs withSentryConfig). org/project는 SENTRY_ORG/SENTRY_PROJECT로.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
