# Assen 웹 환경변수 (복사 → .env.local)
# ⚠️ NEXT_PUBLIC_* 는 빌드 타임에 번들로 인라인된다 — 컨테이너는 build-arg로 주입(web/Dockerfile).

# 사이트 절대 URL (metadataBase·sitemap)
NEXT_PUBLIC_SITE_URL=https://assen.example

# 백엔드 B-API 베이스. 미설정 시 lib/api가 in-file mock으로 폴백(백엔드 없이 빌드/개발 가능).
#  - dev 프록시 모드(권장):  /api   (아래 API_PROXY_TARGET 프록시로 동일 오리진화 → 쿠키 Lax 송신)
#  - 크로스 오리진 직접 호출:  https://api.assen.example/api
#    (브라우저에서 직접 호출되므로 웹 오리진이 서버 CORS_ALLOWED_ORIGINS에 등록돼야 한다 — SDLC 11 §4)
NEXT_PUBLIC_API_URL=

# SSR(서버 컴포넌트) 전용 백엔드 절대 URL. 프록시 모드에서 NEXT_PUBLIC_API_URL=/api(상대)면
# 서버 fetch가 절대 URL을 필요로 하므로 여기서 지정한다. 미설정 시 NEXT_PUBLIC_API_URL로 폴백.
#  - 로컬 백엔드 예:  http://127.0.0.1:8000/api
API_INTERNAL_URL=

# dev rewrites 프록시 대상(next.config.mjs). 미설정 시 http://127.0.0.1:8000.
API_PROXY_TARGET=http://127.0.0.1:8000
