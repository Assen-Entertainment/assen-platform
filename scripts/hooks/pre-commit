#!/bin/sh
# pre-commit — Assen Platform 심층 방어 git hook
#
# 목적: Claude Code hook 밖에서의 우회를 차단한다.
#       (직접 git 조작, IDE 플러그인, 자동화 스크립트 등)
#       CONSTRAINTS #25, #31, #32, #27
#
# 설치: scripts/install-hooks.sh 실행 (git config core.hooksPath scripts/hooks)
#
# 오버라이드 (인간 전용):
#   ALLOW_MIGRATIONS=1  — 마이그레이션 파일 커밋 허용
#   ALLOW_GENERATED=1   — *.g.dart / *.freezed.dart 커밋 허용

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

FAIL=0

# ---------------------------------------------------------------------------
# #25 마이그레이션 파일 커밋 차단
# WHY: migrations는 makemigrations로만 생성, 적용은 인간 승인 필요.
# ---------------------------------------------------------------------------
if [ "${ALLOW_MIGRATIONS}" != "1" ]; then
    MIGRATION_FILES=$(git diff --cached --name-only | grep -E '^server/.*/migrations/.*\.py$' || true)
    if [ -n "${MIGRATION_FILES}" ]; then
        printf "${RED}[PRE-COMMIT BLOCKED]${NC} #25 마이그레이션 인간 게이트\n" >&2
        printf "  다음 마이그레이션 파일이 staged 되어 있습니다:\n" >&2
        printf "  %s\n" ${MIGRATION_FILES} >&2
        printf "  migrations는 makemigrations로만 생성하고, 적용·수정은 인간 승인 필요.\n" >&2
        printf "  인간이 검토 후 ALLOW_MIGRATIONS=1 으로 오버라이드하세요.\n" >&2
        FAIL=1
    fi
fi

# ---------------------------------------------------------------------------
# #32 생성 파일 커밋 차단 (*.g.dart / *.freezed.dart)
# WHY: 생성 파일 손편집 금지 — build_runner 재실행으로만 변경.
# ---------------------------------------------------------------------------
if [ "${ALLOW_GENERATED}" != "1" ]; then
    GENERATED_FILES=$(git diff --cached --name-only | grep -E '\.(g\.dart|freezed\.dart)$' || true)
    if [ -n "${GENERATED_FILES}" ]; then
        printf "${RED}[PRE-COMMIT BLOCKED]${NC} #32 생성 파일 손편집 감지\n" >&2
        printf "  다음 생성 파일이 staged 되어 있습니다:\n" >&2
        printf "  %s\n" ${GENERATED_FILES} >&2
        printf "  *.g.dart / *.freezed.dart 는 build_runner가 관리합니다.\n" >&2
        printf "  소스를 수정 후 'flutter pub run build_runner build'를 실행하고 재커밋하세요.\n" >&2
        printf "  인간이 검토 후 ALLOW_GENERATED=1 으로 오버라이드하세요.\n" >&2
        FAIL=1
    fi
fi

# ---------------------------------------------------------------------------
# #27 gitleaks 시크릿 스캔
# WHY: CI가 최종 게이트이지만, 로컬에서 조기 차단.
#      ~/bin-tools/gitleaks 없으면 경고만 (CI가 잡는다).
# ---------------------------------------------------------------------------
GITLEAKS_BIN="${HOME}/bin-tools/gitleaks"
if [ -x "${GITLEAKS_BIN}" ]; then
    if ! "${GITLEAKS_BIN}" protect --staged --no-banner 2>/dev/null; then
        printf "${RED}[PRE-COMMIT BLOCKED]${NC} #27 gitleaks 시크릿 스캔 실패\n" >&2
        printf "  staged 변경사항에서 시크릿이 감지되었습니다.\n" >&2
        printf "  시크릿을 제거하고 git history를 정리한 후 재커밋하세요.\n" >&2
        FAIL=1
    fi
else
    printf "${YELLOW}[PRE-COMMIT WARNING]${NC} gitleaks 미설치 (~/bin-tools/gitleaks)\n" >&2
    printf "  CI gitleaks 스캔이 최종 게이트입니다. 로컬 설치를 권장합니다.\n" >&2
fi

# ---------------------------------------------------------------------------
# 최종 판정
# ---------------------------------------------------------------------------
if [ "${FAIL}" = "1" ]; then
    printf "\n${RED}커밋 거부됨.${NC} 위의 사유를 확인하세요.\n" >&2
    exit 1
fi

exit 0
